create_clock -name clk -period 20.000 [get_ports clk]
set_clock_uncertainty 0.250 [get_clocks clk]
set_clock_transition 0.150 [get_clocks clk]
set_input_delay -clock clk 3.000 [get_ports reset]
set_input_delay -clock clk 3.000 [get_ports sensor_valid]
set_input_delay -clock clk 3.000 [get_ports sensor_data*]
set_input_delay -clock clk 3.000 [get_ports uart_rx]
set_input_delay -clock clk 3.000 [get_ports wb_host_cyc_i]
set_input_delay -clock clk 3.000 [get_ports wb_host_stb_i]
set_input_delay -clock clk 3.000 [get_ports wb_host_we_i]
set_input_delay -clock clk 3.000 [get_ports wb_host_sel_i*]
set_input_delay -clock clk 3.000 [get_ports wb_host_adr_i*]
set_input_delay -clock clk 3.000 [get_ports wb_host_dat_i*]
set_output_delay -clock clk 3.000 [get_ports sensor_result_valid]
set_output_delay -clock clk 3.000 [get_ports sensor_result*]
set_output_delay -clock clk 3.000 [get_ports accelerator_irq]
set_output_delay -clock clk 3.000 [get_ports boot_release]
set_output_delay -clock clk 3.000 [get_ports boot_fail]
set_output_delay -clock clk 3.000 [get_ports core_trap]
set_output_delay -clock clk 3.000 [get_ports sensor_alert]
set_output_delay -clock clk 3.000 [get_ports uart_tx]
set_output_delay -clock clk 3.000 [get_ports wb_host_ack_o]
set_output_delay -clock clk 3.000 [get_ports wb_host_dat_o*]
set_driving_cell -lib_cell sky130_fd_sc_hd__inv_2 [all_inputs]
set_load 0.035 [all_outputs]
