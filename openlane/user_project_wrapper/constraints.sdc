create_clock -name wb_clk_i -period 10.000 [get_ports wb_clk_i]
set_clock_uncertainty 0.250 [get_clocks wb_clk_i]
set_clock_transition 0.150 [get_clocks wb_clk_i]
set_input_delay -clock wb_clk_i 2.000 [get_ports wb_rst_i]
set_input_delay -clock wb_clk_i 2.000 [get_ports wbs_stb_i]
set_input_delay -clock wb_clk_i 2.000 [get_ports wbs_cyc_i]
set_input_delay -clock wb_clk_i 2.000 [get_ports wbs_we_i]
set_input_delay -clock wb_clk_i 2.000 [get_ports wbs_sel_i*]
set_input_delay -clock wb_clk_i 2.000 [get_ports wbs_dat_i*]
set_input_delay -clock wb_clk_i 2.000 [get_ports wbs_adr_i*]
set_input_delay -clock wb_clk_i 2.000 [get_ports la_data_in*]
set_input_delay -clock wb_clk_i 2.000 [get_ports la_oenb*]
set_input_delay -clock wb_clk_i 2.000 [get_ports io_in*]
set_output_delay -clock wb_clk_i 2.000 [get_ports wbs_ack_o]
set_output_delay -clock wb_clk_i 2.000 [get_ports wbs_dat_o*]
set_output_delay -clock wb_clk_i 2.000 [get_ports la_data_out*]
set_output_delay -clock wb_clk_i 2.000 [get_ports io_out*]
set_output_delay -clock wb_clk_i 2.000 [get_ports io_oeb*]
set_output_delay -clock wb_clk_i 2.000 [get_ports user_irq*]
set_driving_cell -lib_cell sky130_fd_sc_hd__inv_2 [all_inputs]
set_load 0.035 [all_outputs]
